# Normalize text to LF
* text=auto eol=lf

# Python
*.py text eol=lf diff=python

# Shell
*.sh text eol=lf

# Configs
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.env  text eol=lf
requirements*.txt text eol=lf
*.proto text eol=lf
Dockerfile text eol=lf
Makefile  text eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz  binary
*.tar binary

services/weather/interfaces/grpc/generated/*.py -text
